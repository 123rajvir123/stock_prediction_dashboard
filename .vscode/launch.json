{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (Expose to Network)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--host",
                "0.0.0.0",
                "--port",
                "5000"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        }
    ]
}
